       293       3  Passenger_293    male   26.884904      0      2   84.743881        S         1\n","293          294       2  Passenger_294    male   11.962285      0      1    9.004657        S         1\n","294          295       1  Passenger_295  female   27.051083      0      0   16.845510        S         1\n","295          296       3  Passenger_296  female   26.727317      0      0   61.843393        S         0\n","296          297       3  Passenger_297  female   -2.362640      0      0   55.342196        C         1\n","297          298       2  Passenger_298  female   29.348462      0      0    6.177585        Q         0\n","298          299       3  Passenger_299    male   27.228786      1      0   48.682277        S         1\n","299          300       1  Passenger_300    male   38.354476      0      1   18.385024        S         0\n"]}],"source":["# Vamos criar um dataset similar ao Titanic para o exercício\n","\n","import pandas as pd\n","pd.set_option('display.max_columns', None)        # mostra todas as colunas\n","pd.set_option('display.max_colwidth', None)       # não trunca o conteúdo das células\n","pd.set_option('display.width', None)              # deixa o pandas calcular a largura (evita wrap automático)\n","pd.set_option('display.expand_frame_repr', False) # evita quebra do DataFrame em múltiplas linhas\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.preprocessing import StandardScaler, MinMaxScaler, LabelEncoder\n","from sklearn.model_selection import train_test_split\n","\n","# Definir seed para reprodutibilidade\n","np.random.seed(42)\n","n_passengers = 300\n","\n","# Criar dados simulados do Titanic\n","titanic_data = {\n","    'PassengerId': range(1, n_passengers + 1),                               # ID único para cada passageiro\n","    'Pclass': np.random.choice([1, 2, 3], n_passengers, p=[0.2, 0.3, 0.5]),  # Classe do bilhete\n","    'Name': [f'Passenger_{i}' for i in range(1, n_passengers + 1)],          # Nome do passageiro\n","    'Sex': np.random.choice(['male', 'female'], n_passengers),               # Sexo\n","    'Age': np.random.normal(30, 12, n_passengers),                           # Idade com distribuição normal\n","    'SibSp': np.random.poisson(0.5, n_passengers),                           # Número de irmãos/cônjuges\n","    'Parch': np.random.poisson(0.3, n_passengers),                           # Número de pais/filhos\n","    'Fare': np.random.exponential(30, n_passengers),                         # Tarifa paga\n","    'Embarked': np.random.choice(['C', 'Q', 'S'], n_passengers, p=[0.2, 0.1, 0.7]),  # Porto de embarque\n","    'Survived': np.random.choice([0, 1], n_passengers, p=[0.6, 0.4])         # Sobreviveu (0=Não, 1=Sim)\n","}\n","\n","# Criar DataFrame\n","df_titanic = pd.DataFrame(titanic_data)\n","\n","# Introduzir alguns problemas nos dados\n","# Valores ausentes na idade\n","missing_age = np.random.choice(df_titanic.index, size=30, replace=False)\n","df_titanic.loc[missing_age, 'Age'] = np.nan\n","\n","# Valores ausentes no porto de embarque\n","missing_embarked = np.random.choice(df_titanic.index, size=5, replace=False)\n","df_titanic.loc[missing_embarked, 'Embarked'] = np.nan\n","\n","# Introduzir outliers na idade\n","df_titanic.loc[df_titanic.index[:3], 'Age'] = [150, -5, 200]\n","\n","print(\"Dataset Titanic criado!\")\n","print(f\"Shape: {df_titanic.shape}\")\n","#print(\"\\nPrimeiras linhas:\")\n","print(df_titanic.to_string())"]},{"cell_type":"markdown","id":"Uqll610tTyfX","metadata":{"id":"Uqll610tTyfX"},"source":["## Exercício 1\n","\n","Complete as seguintes tarefas:\n"]},{"cell_type":"code","execution_count":null,"id":"d98d8c74","metadata":{"id":"d98d8c74"},"outputs":[],"source":["# 1. Faça uma análise exploratória básica\n","print(\"=== ANÁLISE EXPLORATÓRIA - TITANIC ===\")\n","\n","# Informações gerais do dataset\n","print(\"Informações gerais:\")\n","# .info()\n","\n","# Verificar valores ausentes\n","print(\"\\nValores ausentes por coluna:\")\n","# .isnull().sum()\n","\n","# Estatísticas descritivas para variáveis numéricas\n","print(\"\\nEstatísticas descritivas - Variáveis numéricas:\")\n","# .describe()\n","\n","# Estatísticas descritivas para variáveis categóricas\n","print(\"\\nEstatísticas descritivas - Variáveis categóricas:\")\n","# .describe(include=['object'])\n","\n","# Distribuição da variável alvo\n","print(\"\\nDistribuição da variável 'Survived':\")\n","# .value_counts()"]},{"cell_type":"code","execution_count":null,"id":"Xk31NkjNT7d9","metadata":{"id":"Xk31NkjNT7d9"},"outputs":[],"source":["# 2. Identifique e trate valores ausentes\n","print(\"\\n=== TRATAMENTO DE VALORES AUSENTES ===\")\n","\n","# Criar cópia para trabalhar\n","df_clean = df_titanic.copy()\n","\n","# Tratar valores ausentes na idade - usar mediana\n","print(\"Tratando valores ausentes na idade...\")\n","\n","# Tratar valores ausentes no porto de embarque - usar moda\n","print(\"Tratando valores ausentes no porto de embarque...\")\n","\n","# Verificar se ainda há valores ausentes\n","print(f\"Valores ausentes após tratamento: {df_clean.isnull().sum().sum()}\")"]},{"cell_type":"code","execution_count":null,"id":"cF9yYEcCT7lL","metadata":{"id":"cF9yYEcCT7lL"},"outputs":[],"source":["# 3. Identifique e trate outliers\n","print(\"\\n=== TRATAMENTO DE OUTLIERS ===\")\n","# TODO: Use boxplots ou método IQR para identificar e tratar outliers"]},{"cell_type":"code","execution_count":null,"id":"OK7yjSyMT7rx","metadata":{"id":"OK7yjSyMT7rx"},"outputs":[],"source":["# 4. Codifique variáveis categóricas\n","print(\"\\n=== CODIFICAÇÃO DE VARIÁVEIS ===\")\n","# TODO: Aplique Label Encoding ou One-Hot Encoding conforme apropriado"]},{"cell_type":"markdown","id":"1a06f459","metadata":{"id":"1a06f459"},"source":["## Exercício resolvido\n","\n","Execute o código abaixo e observe o efeito de diferentes técnicas de normalização nos dados."]},{"cell_type":"code","execution_count":null,"id":"8756d96c","metadata":{"id":"8756d96c"},"outputs":[],"source":["from sklearn.preprocessing import RobustScaler, PowerTransformer\n","\n","print(\"=== COMPARAÇÃO DE TÉCNICAS DE NORMALIZAÇÃO ===\")\n","\n","# Preparar dados para comparação\n","# Usar apenas variáveis numéricas do dataset limpo\n","numeric_data = df_clean[['Age', 'Fare', 'SibSp', 'Parch']].copy()\n","\n","# Criar diferentes tipos de distribuições para demonstrar\n","np.random.seed(42)\n","\n","# Adicionar uma variável com distribuição assimétrica\n","numeric_data['Skewed_Var'] = np.random.exponential(2, len(numeric_data))\n","\n","# Adicionar uma variável com outliers extremos\n","normal_data = np.random.normal(50, 10, len(numeric_data))\n","outlier_indices = np.random.choice(len(numeric_data), 10, replace=False)\n","normal_data[outlier_indices] = np.random.normal(200, 20, 10)  # Outliers extremos\n","numeric_data['With_Outliers'] = normal_data\n","\n","print(f\"Dados para normalização - Shape: {numeric_data.shape}\")\n","print(\"\\nEstatísticas descritivas originais:\")\n","print(numeric_data.describe())\n","\n","# 1. Aplicar diferentes técnicas de normalização\n","print(\"\\n1. Aplicando diferentes técnicas de normalização...\")\n","\n","# Inicializar os scalers\n","scalers = {\n","    'StandardScaler': StandardScaler(),\n","    'MinMaxScaler': MinMaxScaler(),\n","    'RobustScaler': RobustScaler(),\n","    'PowerTransformer': PowerTransformer(method='yeo-johnson')\n","}\n","\n","# Dicionário para armazenar resultados\n","normalized_data = {}\n","\n","# Aplicar cada técnica\n","for name, scaler in scalers.items():\n","    print(f\"   Aplicando {name}...\")\n","    normalized_data[name] = pd.DataFrame(\n","        scaler.fit_transform(numeric_data),\n","        columns=numeric_data.columns,\n","        index=numeric_data.index\n","    )\n","\n","# 2. Comparar visualmente os resultados com histogramas\n","print(\"\\n2. Criando visualizações comparativas...\")\n","\n","# Selecionar algumas variáveis para visualização\n","vars_to_plot = ['Age', 'Fare', 'Skewed_Var', 'With_Outliers']\n","\n","# Criar subplots para cada variável\n","fig, axes = plt.subplots(len(vars_to_plot), len(scalers) + 1, figsize=(20, 16))\n","fig.suptitle('Comparação de Técnicas de Normalização', fontsize=16)\n","\n","for i, var in enumerate(vars_to_plot):\n","    # Plot original\n","    axes[i, 0].hist(numeric_data[var], bins=30, alpha=0.7, color='gray')\n","    axes[i, 0].set_title(f'{var} - Original')\n","    axes[i, 0].set_ylabel('Frequência')\n","\n","    # Plot para cada técnica de normalização\n","    for j, (scaler_name, data) in enumerate(normalized_data.items()):\n","        axes[i, j + 1].hist(data[var], bins=30, alpha=0.7)\n","        axes[i, j + 1].set_title(f'{var} - {scaler_name}')\n","\n","        # Adicionar estatísticas no gráfico\n","        mean_val = data[var].mean()\n","        std_val = data[var].std()\n","        axes[i, j + 1].axvline(mean_val, color='red', linestyle='--', alpha=0.7)\n","        axes[i, j + 1].text(0.02, 0.95, f'μ={mean_val:.2f}\\nσ={std_val:.2f}',\n","                           transform=axes[i, j + 1].transAxes, verticalalignment='top',\n","                           bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# 3. Análise quantitativa das transformações\n","print(\"\\n3. Análise quantitativa das transformações:\")\n","\n","# Criar tabela comparativa\n","comparison_results = []\n","\n","for var in vars_to_plot:\n","    # Dados originais\n","    orig_stats = {\n","        'Variable': var,\n","        'Scaler': 'Original',\n","        'Mean': numeric_data[var].mean(),\n","        'Std': numeric_data[var].std(),\n","        'Min': numeric_data[var].min(),\n","        'Max': numeric_data[var].max(),\n","        'Skewness': numeric_data[var].skew()\n","    }\n","    comparison_results.append(orig_stats)\n","\n","    # Para cada técnica de normalização\n","    for scaler_name, data in normalized_data.items():\n","        stats = {\n","            'Variable': var,\n","            'Scaler': scaler_name,\n","            'Mean': data[var].mean(),\n","            'Std': data[var].std(),\n","            'Min': data[var].min(),\n","            'Max': data[var].max(),\n","            'Skewness': data[var].skew()\n","        }\n","        comparison_results.append(stats)\n","\n","# Converter para DataFrame para melhor visualização\n","comparison_df = pd.DataFrame(comparison_results)\n","\n","# Mostrar resultados por variável\n","for var in vars_to_plot:\n","    print(f\"\\n--- {var} ---\")\n","    var_results = comparison_df[comparison_df['Variable'] == var]\n","    print(var_results[['Scaler', 'Mean', 'Std', 'Min', 'Max', 'Skewness']].round(3))\n","\n","# 4. Recomendações baseadas nos resultados\n","print(\"\\n4. ANÁLISE E RECOMENDAÇÕES:\")\n","\n","print(\"\"\"\n","CARACTERÍSTICAS DE CADA TÉCNICA:\n","\n","1. StandardScaler (Z-score):\n","   - Centraliza dados em média=0, desvio=1\n","   - Preserva a forma da distribuição original\n","   - Sensível a outliers\n","   - Melhor para: distribuições normais sem outliers extremos\n","\n","2. MinMaxScaler:\n","   - Escala dados para intervalo [0,1]\n","   - Preserva relações entre valores\n","   - Muito sensível a outliers\n","   - Melhor para: quando você precisa de um intervalo específico\n","\n","3. RobustScaler:\n","   - Usa mediana e IQR em vez de média e desvio\n","   - Robusto a outliers\n","   - Não garante intervalo específico\n","   - Melhor para: dados com outliers significativos\n","\n","4. PowerTransformer (Yeo-Johnson):\n","   - Tenta tornar os dados mais próximos de uma distribuição normal\n","   - Pode reduzir assimetria\n","   - Transforma a distribuição original\n","   - Melhor para: dados com distribuições muito assimétricas\n","\n","RECOMENDAÇÕES POR TIPO DE DADOS:\n","- Dados normais sem outliers: StandardScaler\n","- Dados com outliers: RobustScaler\n","- Dados muito assimétricos: PowerTransformer\n","- Quando precisar de intervalo [0,1]: MinMaxScaler\n","- Para redes neurais: geralmente StandardScaler ou MinMaxScaler\n","- Para algoritmos baseados em distância: StandardScaler ou RobustScaler\n","\"\"\")\n","\n","# Exemplo prático de escolha\n","print(\"\\nEXEMPLO PRÁTICO - Escolha da técnica:\")\n","for var in vars_to_plot:\n","    original_skew = abs(numeric_data[var].skew())\n","    has_outliers = len(numeric_data[var][\n","        (numeric_data[var] < numeric_data[var].quantile(0.25) - 1.5 *\n","         (numeric_data[var].quantile(0.75) - numeric_data[var].quantile(0.25))) |\n","        (numeric_data[var] > numeric_data[var].quantile(0.75) + 1.5 *\n","         (numeric_data[var].quantile(0.75) - numeric_data[var].quantile(0.25)))\n","    ]) > 0\n","\n","    print(f\"\\n{var}:\")\n","    print(f\"  Assimetria: {original_skew:.2f}\")\n","    print(f\"  Tem outliers: {has_outliers}\")\n","\n","    if original_skew > 2:\n","        recommendation = \"PowerTransformer (muito assimétrico)\"\n","    elif has_outliers:\n","        recommendation = \"RobustScaler (presença de outliers)\"\n","    else:\n","        recommendation = \"StandardScaler (distribuição bem comportada)\"\n","\n","    print(f\"  Recomendação: {recommendation}\")\n","\n","print(\"\\nComparação de técnicas de normalização concluída!\")"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}